# MGH Timekeeping & Payroll — Staging Environment Configuration
NODE_ENV=staging
PORT=5050

# Database Configuration (supports sqlite or postgres)
DATABASE_CLIENT=sqlite
DB_FILE=data/payroll_staging.db

# In Managed PostgreSQL Staging Mode:
# DATABASE_CLIENT=postgres
# DATABASE_URL=postgresql://mgh_app:staging_secret@staging-db.myglobalhub.internal:5432/mgh_payroll_staging
# PG_HOST=staging-db.myglobalhub.internal
# PG_PORT=5432
# PG_DATABASE=mgh_payroll_staging
# PG_USER=mgh_app
# PG_PASSWORD=staging_secret
# PG_SSL=true

# Security & CORS
CORS_ORIGIN=https://staging-payroll.myglobalhub.internal
JWT_SECRET=staging-enterprise-secret-key-mgh-987654321
SESSION_TTL_HOURS=168

# Storage & Attachments
STORAGE_PATH=uploads
MAX_FILE_SIZE_MB=25

# Jira Cloud Integration
JIRA_HOST=https://myglobalhub.atlassian.net
JIRA_EMAIL=integrations@myglobalhub.com
JIRA_PROJECT_KEY=MSH

# Logging & Monitoring
LOG_LEVEL=info
ENABLE_AUDIT_LOGS=true
