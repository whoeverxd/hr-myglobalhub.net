# Configuración Web de Firebase para Google Auth
# Obtén estos valores en: Firebase Console -> Configuración del proyecto -> General -> Tus apps (Web)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hr-myglobalhub-net.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hr-myglobalhub-net
VITE_FIREBASE_STORAGE_BUCKET=hr-myglobalhub-net.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
